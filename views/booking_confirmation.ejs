<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Booking Confirmed - MSRTC</title>

  <link rel="icon" type="image/svg+xml" href="/images/msrtc-logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <style>
    /* =========================================================
       Booking Confirmation Page Styles
       ========================================================= */

    .confirmation-main {
      padding: 40px 20px 80px;
      max-width: 760px;
      margin: 0 auto;
      width: 100%;
    }

    /* ── Success Banner ───────────────────────────────────────── */
    .confirmation-banner {
      background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
      border-radius: 20px;
      padding: 40px 32px;
      text-align: center;
      color: #ffffff;
      margin-bottom: 32px;
      box-shadow: 0 8px 30px rgba(22, 163, 74, 0.3);
      position: relative;
      overflow: hidden;
    }

    .confirmation-banner::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 180px; height: 180px;
      background: rgba(255,255,255,0.06);
      border-radius: 50%;
    }

    .confirmation-banner::after {
      content: '';
      position: absolute;
      bottom: -60px; left: -20px;
      width: 220px; height: 220px;
      background: rgba(255,255,255,0.04);
      border-radius: 50%;
    }

    .success-icon-circle {
      width: 72px;
      height: 72px;
      background: rgba(255,255,255,0.18);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      border: 2px solid rgba(255,255,255,0.35);
    }

    .confirmation-title {
      font-family: var(--font-heading);
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .confirmation-subtitle {
      font-size: 1rem;
      opacity: 0.88;
      font-weight: 500;
    }

    .booking-id-pill {
      display: inline-block;
      background: rgba(255,255,255,0.18);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 999px;
      padding: 6px 18px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-top: 16px;
    }

    /* ── Details Card ─────────────────────────────────────────── */
    .details-card {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 4px 18px rgba(0,0,0,0.06);
      overflow: hidden;
      margin-bottom: 20px;
    }

    .details-card-header {
      background: #f8fafc;
      padding: 16px 24px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--secondary);
    }

    .details-card-body {
      padding: 24px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.93rem;
    }

    .detail-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .detail-label {
      color: var(--muted-text);
      font-weight: 500;
    }

    .detail-value {
      font-weight: 700;
      color: var(--dark-text);
      text-align: right;
      max-width: 60%;
    }

    /* ── Seat Badges ──────────────────────────────────────────── */
    .booked-seats-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
    }

    .booked-seat-badge {
      background: #16a34a;
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(22,163,74,0.3);
    }

    /* ── Fare Highlight ───────────────────────────────────────── */
    .fare-highlight-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 12px;
      padding: 16px 24px;
      margin-top: 20px;
    }

    .fare-highlight-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: #15803d;
    }

    .fare-highlight-amount {
      font-size: 1.8rem;
      font-weight: 900;
      color: #16a34a;
      font-family: var(--font-heading);
    }

    /* ── Action Buttons ───────────────────────────────────────── */
    .confirmation-actions {
      display: flex;
      gap: 14px;
      margin-top: 28px;
      flex-wrap: wrap;
    }

    .btn-home {
      flex: 1;
      min-width: 160px;
      padding: 14px 24px;
      background: var(--primary-gradient);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 800;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(243,83,27,0.3);
      transition: all 0.2s ease;
    }

    .btn-home:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(243,83,27,0.4);
    }

    .btn-search-again {
      flex: 1;
      min-width: 160px;
      padding: 14px 24px;
      background: #ffffff;
      color: var(--secondary);
      border: 2px solid #e5e7eb;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-search-again:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    @media (max-width: 540px) {
      .confirmation-banner { padding: 28px 20px; }
      .confirmation-title  { font-size: 1.5rem; }
      .confirmation-actions { flex-direction: column; }
    }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <main class="confirmation-main">

    <%
      /* Format journey date for display */
      let formattedDate = 'N/A';
      if (bus && bus.journeyDate) {
        const d = new Date(bus.journeyDate);
        if (!isNaN(d.getTime())) {
          formattedDate = d.toLocaleDateString('en-IN', {
            weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
          });
        }
      }

      /* Format booking creation time */
      let bookedAtStr = 'N/A';
      if (booking && booking.createdAt) {
        const bd = new Date(booking.createdAt);
        if (!isNaN(bd.getTime())) {
          bookedAtStr = bd.toLocaleString('en-IN', {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
          });
        }
      }
    %>

    <!-- ── Success Banner ──────────────────────────────────────── -->
    <div class="confirmation-banner">
      <div class="success-icon-circle">
        <!-- Checkmark SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"
             fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <h1 class="confirmation-title">Booking Confirmed!</h1>
      <p class="confirmation-subtitle">
        Your seats have been successfully reserved on MSRTC.
      </p>
      <span class="booking-id-pill">
        Booking ID: <%= booking._id %>
      </span>
    </div>

    <!-- ── Journey Details ─────────────────────────────────────── -->
    <div class="details-card">
      <div class="details-card-header">🚌 Journey Details</div>
      <div class="details-card-body">

        <div class="detail-row">
          <span class="detail-label">Bus Service</span>
          <span class="detail-value"><%= bus.busName || 'MSRTC Bus' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Bus Number</span>
          <span class="detail-value"><%= bus.busNumber || 'N/A' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Bus Type</span>
          <span class="detail-value"><%= bus.busType || 'Express' %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Route</span>
          <span class="detail-value"><%= bus.fromPlace %> → <%= bus.toPlace %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Journey Date</span>
          <span class="detail-value"><%= formattedDate %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Departure Time</span>
          <span class="detail-value"><%= bus.departureTime || 'N/A' %></span>
        </div>

      </div>
    </div>

    <!-- ── Booking Details ─────────────────────────────────────── -->
    <div class="details-card">
      <div class="details-card-header">🎫 Booking Details</div>
      <div class="details-card-body">

        <div class="detail-row">
          <span class="detail-label">Booking Status</span>
          <span class="detail-value" style="color: #16a34a;">✓ Confirmed</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Booked On</span>
          <span class="detail-value"><%= bookedAtStr %></span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Seats Booked</span>
          <span class="detail-value"><%= booking.seatNumbers.length %> seat<%= booking.seatNumbers.length > 1 ? 's' : '' %></span>
        </div>

        <!-- Booked Seat Badges -->
        <div class="detail-row" style="flex-direction: column; gap: 10px; align-items: flex-start;">
          <span class="detail-label">Seat Numbers</span>
          <div class="booked-seats-grid">
            <% booking.seatNumbers.forEach(seat => { %>
              <span class="booked-seat-badge"><%= seat %></span>
            <% }); %>
          </div>
        </div>

        <div class="detail-row">
          <span class="detail-label">Fare Per Seat</span>
          <span class="detail-value">₹<%= booking.farePerSeat %></span>
        </div>

      </div>
    </div>

    <!-- ── Total Fare Highlight ────────────────────────────────── -->
    <div class="fare-highlight-row">
      <span class="fare-highlight-label">Total Amount Paid</span>
      <span class="fare-highlight-amount">₹<%= booking.totalFare.toLocaleString('en-IN') %></span>
    </div>

    <!-- ── Action Buttons ──────────────────────────────────────── -->
    <div class="confirmation-actions">
      <a href="/" class="btn-home">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Back to Home
      </a>
      <a href="/" class="btn-search-again">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        Book Another Bus
      </a>
    </div>

  </main>

  <%- include('partials/footer') %>

</body>
</html>

